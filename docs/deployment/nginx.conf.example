# Sample nginx configuration for augchatd's mTLS-protected control plane.
#
# augchatd does NOT terminate TLS itself (see adr-0012-out-of-process-tls).
# nginx accepts the mTLS handshake, validates the client cert against the
# configured CA bundle, and forwards two headers to augchatd:
#
#   X-Client-Cert-Verify:  "SUCCESS" iff $ssl_client_verify == "SUCCESS"
#   X-Client-Cert-Subject: $ssl_client_s_dn (RFC 2253 form)
#
# augchatd's `requireMtlsTrust` middleware refuses any request whose
# X-Client-Cert-Verify is not exactly "SUCCESS". Set TRUSTED_PROXY=true on
# the augchatd process so it actually mounts the mTLS-protected routes.
#
# IMPORTANT: augchatd MUST be reachable only from this proxy. Bind it to
# loopback (127.0.0.1) or a unix socket; never expose port 8080 directly
# to the network. The header trust is a declarative agreement — nothing
# else verifies that the request came from nginx.

# Browser-facing JWT API (Origin policy is enforced by augchatd's own
# routes; nginx just terminates regular TLS for the bundled UI + /chat).
server {
    listen 443 ssl;
    http2 on;
    server_name augchatd.example.com;

    ssl_certificate     /etc/ssl/augchatd/server.crt;
    ssl_certificate_key /etc/ssl/augchatd/server.key;

    # No client-cert verification here — this is the browser-facing leg.
    # The JWT-bearer middleware on augchatd guards the chat-time routes.

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        # Strip any inbound impersonation of the mTLS headers. The
        # browser-facing leg never carries client certs; if a request
        # reaches augchatd through this server block claiming SUCCESS
        # without a real cert verification, it's an attack.
        proxy_set_header   X-Client-Cert-Verify  "";
        proxy_set_header   X-Client-Cert-Subject "";
        # SSE / streaming: disable response buffering so chat tokens land
        # in the browser as they arrive.
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}

# mTLS control-plane (POST /sessions, DELETE /sessions/:id). Typically on
# a separate hostname or port; integrators reach this from their backend,
# not the browser.
server {
    listen 8443 ssl;
    http2 on;
    server_name augchatd-mtls.example.com;

    ssl_certificate     /etc/ssl/augchatd/server.crt;
    ssl_certificate_key /etc/ssl/augchatd/server.key;

    # Verify the client cert against the integrator's CA bundle. `on`
    # makes the cert mandatory; `optional` would let unverified clients
    # through with $ssl_client_verify == "NONE", which augchatd would
    # then 401 anyway, but we'd rather fail at the proxy.
    ssl_client_certificate /etc/ssl/augchatd/clients-ca.crt;
    ssl_verify_client      on;
    ssl_verify_depth       2;

    location /sessions {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host                  $host;
        proxy_set_header   X-Forwarded-For       $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto     https;
        # Forward the proof-of-mTLS:
        proxy_set_header   X-Client-Cert-Verify  $ssl_client_verify;
        proxy_set_header   X-Client-Cert-Subject $ssl_client_s_dn;
    }

    # Everything else on the mTLS leg returns 404 at the proxy — only
    # session-management traffic belongs here.
    location / { return 404; }
}
